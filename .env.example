WEB_HOST=127.0.0.1
WEB_PORT=3000
PHONE_FARM_ROLE=standalone
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4725
DATABASE_URL=postgresql://phone_farm:CHANGE_ME@127.0.0.1:5432/phone_farm
POSTGRES_DB=phone_farm
POSTGRES_USER=phone_farm
POSTGRES_PASSWORD=CHANGE_ME
# Comma-separated ESM packages. Empty is a valid fleet-only installation.
PHONE_FARM_PLUGINS=
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
INSTAGRAM_BUNDLE_ID=com.burbn.instagram
# Instagram cold DM lead lists live in data/leads/<name>.json (see data/leads/README.md).
# LEADS_DIR=data/leads
# COLD_DMS_BETWEEN_MS=2500
# COLD_DMS_JITTER_MS=1500
# Required before WEB_HOST is changed away from loopback.
# PHONE_FARM_AUTH_PLUGIN=@your-organization/phone-farm-auth
DEVICES_CONFIG_PATH=devices.json
# Device unlock passcodes live in devices.json ("passcode" per entry), which is
# git-ignored and written 0600 — not in this file.
SCHEDULER_DATA_DIR=.scheduler-data
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100
# Live Control preview quality (WDA MJPEG). Lower = smoother under TikTok/Appium.
# Scaling is percent of full resolution; screenshot quality is 0–100 JPEG.
MJPEG_SCALING_FACTOR=40
MJPEG_SERVER_SCREENSHOT_QUALITY=25

# Optional. `wda:prepare` / `wda:start` target the sole registered (devices.json)
# or connected device, or take `--udid <udid>`. Set this only to pin one device
# for the CLI scripts. `xcrun xctrace list devices` lists UDIDs.
# IOS_UDID=
IOS_PLATFORM_VERSION=16.7
# Required for WDA build/signing on a physical device.
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID=Apple Development
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner

# Distributed topology (recommended for production):
# - MiniPC Linux: PHONE_FARM_ROLE=control-plane
# - Mac attached to iPhones: PHONE_FARM_ROLE=device-worker
# Control-plane format: worker-id=http://host-or-tailnet-name:3010[,worker-id=...]
# PHONE_FARM_DEVICE_WORKERS=macstudio=http://macstudio:3010
# Shared secret used by the control plane when calling device-worker gateways.
# PHONE_FARM_DEVICE_WORKER_TOKEN=
# Shared secret used by device workers to fetch canonical config/assets from the MiniPC.
# PHONE_FARM_INTERNAL_TOKEN=
# Device worker identity/listen address.
# PHONE_FARM_WORKER_ID=macstudio
# DEVICE_WORKER_HOST=127.0.0.1
# DEVICE_WORKER_PORT=3010
# Device workers can point back to the MiniPC control plane for canonical config/assets.
# PHONE_FARM_CONTROL_PLANE_URL=http://minipc:3000
# Device-worker only: names of preconfigured network/egress contexts. The
# control plane sees IDs/device scope, never proxy/VPN credentials or endpoints.
# PHONE_FARM_NETWORK_ROUTES=direct,testing-eu
