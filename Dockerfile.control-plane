FROM node:22-bookworm-slim AS verify-tools

WORKDIR /tools

# The Linux control-plane build needs TypeScript typechecking, but it does not
# need the macOS-only Appium toolchains kept in the repository's devDependencies.
# Keep this tiny tool layer exact and independently auditable.
RUN npm init -y >/dev/null \
    && npm install --ignore-scripts --save-exact \
        typescript@7.0.2 \
        @types/node@26.2.0 \
        @types/pg@8.23.1

FROM node:22-bookworm-slim AS verified

WORKDIR /app

COPY package.json package-lock.json ./
# Verification uses the exact production dependency graph plus a minimal
# TypeScript tool layer. This deliberately excludes Appium/Appium-runtime and
# drizzle-kit: those are Mac/development tools and previously pulled vulnerable
# legacy transitive packages into every MiniPC build despite never executing.
RUN npm ci --omit=dev --ignore-scripts
COPY --from=verify-tools /tools/node_modules/typescript ./node_modules/typescript
COPY --from=verify-tools /tools/node_modules/@typescript ./node_modules/@typescript
COPY --from=verify-tools /tools/node_modules/@types ./node_modules/@types
COPY --from=verify-tools /tools/node_modules/undici-types ./node_modules/undici-types
RUN mkdir -p node_modules/.bin \
    && ln -sf ../typescript/bin/tsc node_modules/.bin/tsc

COPY tsconfig.json tsconfig.web.json drizzle.config.ts ./
COPY drizzle ./drizzle
COPY src ./src
COPY static ./static
COPY Patches ./Patches
COPY donors.lock.json donor-adapters.json ./
COPY integrations ./integrations
COPY deploy ./deploy
COPY toolchains ./toolchains
COPY test ./test

RUN npm run check \
    && npm run build:web \
    && node --import tsx -e "import('./src/api/server.ts').then(() => console.log('control-plane import OK'))"

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

COPY package.json package-lock.json ./
# Production needs tsx to execute the checked TypeScript source, but not the
# Appium/tooling/typecheck dev dependency set used by the verification stage.
RUN npm ci --omit=dev --ignore-scripts
COPY --from=verified /app/tsconfig.json /app/tsconfig.web.json /app/drizzle.config.ts ./
COPY --from=verified /app/drizzle ./drizzle
COPY --from=verified /app/src ./src
COPY --from=verified /app/static ./static
COPY --from=verified /app/Patches ./Patches
COPY --from=verified /app/integrations ./integrations

ENV NODE_ENV=production \
    PHONE_FARM_ROLE=control-plane \
    WEB_HOST=127.0.0.1 \
    WEB_PORT=3000 \
    DEVICES_CONFIG_PATH=/data/devices.json \
    SCHEDULER_DATA_DIR=/data/scheduler

CMD ["sh", "-c", "attempt=1; until npm run db:migrate; do if [ \"$attempt\" -ge 30 ]; then echo 'Database migrations did not become ready after 30 attempts' >&2; exit 1; fi; echo \"Database not ready for migrations (attempt $attempt/30); retrying in 2s\" >&2; attempt=$((attempt + 1)); sleep 2; done; exec node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/api/server.ts"]
