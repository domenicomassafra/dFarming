PHONE_FARM_ROLE=control-plane
WEB_HOST=127.0.0.1
WEB_PORT=4050
PHONE_FARM_TAILSCALE_HTTPS_PORT=18443

POSTGRES_DB=phone_farm
POSTGRES_USER=phone_farm
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
DFARMING_POSTGRES_VOLUME=dfarming-postgres
# Keep 127.0.0.1 unless Mac workers must connect directly to PostgreSQL.
# With Tailscale, set this to the MiniPC's Tailscale IPv4 address instead of 0.0.0.0.
POSTGRES_LISTEN_ADDRESSES=127.0.0.1

# worker-id=http(s)://address:3010[,worker-id=...]
PHONE_FARM_DEVICE_WORKERS=macstudio=http://mac-studio-dodo:3010
PHONE_FARM_DEVICE_WORKER_TOKEN=replace-with-a-long-random-token
PHONE_FARM_INTERNAL_TOKEN=replace-with-a-different-long-random-token
PHONE_FARM_STREAM_SECRET=replace-with-at-least-32-random-bytes
PHONE_FARM_REQUIRE_STREAM_TOKEN=true

# Host UID/GID that owns .runtime/minipc.
PHONE_FARM_UID=1000
PHONE_FARM_GID=1000
PHONE_FARM_DATA_DIR=./.runtime/minipc

PHONE_FARM_PLUGINS=
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
INSTAGRAM_BUNDLE_ID=com.burbn.instagram
