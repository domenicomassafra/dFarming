DFARMING_ROLE=control-plane
WEB_HOST=127.0.0.1
WEB_PORT=4050
DFARMING_TAILSCALE_HTTPS_PORT=18443

POSTGRES_DB=dfarming
POSTGRES_USER=dfarming
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
DFARMING_POSTGRES_VOLUME=dfarming-postgres
# Keep 127.0.0.1 unless Mac workers must connect directly to PostgreSQL.
# With Tailscale, set this to the MiniPC's Tailscale IPv4 address instead of 0.0.0.0.
POSTGRES_LISTEN_ADDRESSES=127.0.0.1

# worker-id=http(s)://address:3010[,worker-id=...]
DFARMING_DEVICE_WORKERS=macstudio=http://mac-studio-dodo:3010
DFARMING_DEVICE_WORKER_TOKEN=replace-with-a-long-random-token
DFARMING_INTERNAL_TOKEN=replace-with-a-different-long-random-token
DFARMING_STREAM_SECRET=replace-with-at-least-32-random-bytes
DFARMING_REQUIRE_STREAM_TOKEN=true

# Host UID/GID that owns .runtime/minipc.
DFARMING_UID=1000
DFARMING_GID=1000
DFARMING_DATA_DIR=./.runtime/minipc

DFARMING_PLUGINS=
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
INSTAGRAM_BUNDLE_ID=com.burbn.instagram
