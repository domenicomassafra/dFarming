DFARMING_ROLE=device-worker
DFARMING_WORKER_ID=android-linux
DFARMING_ENABLE_PHYSICAL_IOS=false
DEVICE_WORKER_HOST=0.0.0.0
DEVICE_WORKER_PORT=3010
DFARMING_DEVICE_WORKER_TOKEN=replace-with-the-same-token-as-minipc

DFARMING_CONTROL_PLANE_URL=https://minipc-ubuntu.garibaldi-atlas.ts.net:18443
DFARMING_INTERNAL_TOKEN=replace-with-the-same-internal-token-as-minipc
DATABASE_URL=postgresql://dfarming:replace-password@minipc-ubuntu:55432/dfarming

# Optional preconfigured egress contexts exposed only as route IDs/device scope.
# Secrets/endpoints remain worker-local and are never advertised to the MiniPC.
# DFARMING_NETWORK_ROUTES=[{"id":"direct"},{"id":"testing-eu","deviceUdids":["127.0.0.1:5555"]}]

APPIUM_RUNTIME_HOST=127.0.0.1
APPIUM_RUNTIME_PORT=4726
DEVICES_CONFIG_PATH=devices.json
SCHEDULER_DATA_DIR=.scheduler-data
DFARMING_RUNTIME_DISK_BUDGET_GB=20
DFARMING_RUNTIME_STALE_DAYS=14
# Optional local-AVD controls. Boot reports success only after sys.boot_completed=1.
# DFARMING_ANDROID_EMULATOR_BOOT_TIMEOUT_MS=120000
# DFARMING_ANDROID_EMULATOR_HEADLESS=true
# Optional display name for deploy/setup-google-android-emulator.sh
# DFARMING_ANDROID_EMULATOR_DISPLAY_NAME=Google Android Emulator API 30

# Appium/UiAutomator2 needs a complete Android SDK, not only an adb binary.
# The installer defaults to this user-local root when these are omitted.
# ANDROID_HOME=/home/your-user/.local/share/android-sdk
# ANDROID_SDK_ROOT=/home/your-user/.local/share/android-sdk
# JAVA_HOME may be omitted when java is available on PATH.

# Optional Android H.264 video transport. The jar/version must match.
# DFARMING_SCRCPY_SERVER_JAR=/absolute/path/to/scrcpy-server.jar
# DFARMING_SCRCPY_VERSION=4.0
# DFARMING_SCRCPY_MAX_SIZE=1920
