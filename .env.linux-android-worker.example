PHONE_FARM_ROLE=device-worker
PHONE_FARM_WORKER_ID=android-linux
PHONE_FARM_ENABLE_PHYSICAL_IOS=false
DEVICE_WORKER_HOST=0.0.0.0
DEVICE_WORKER_PORT=3010
PHONE_FARM_DEVICE_WORKER_TOKEN=replace-with-the-same-token-as-minipc

PHONE_FARM_CONTROL_PLANE_URL=https://minipc-ubuntu.garibaldi-atlas.ts.net:18443
PHONE_FARM_INTERNAL_TOKEN=replace-with-the-same-internal-token-as-minipc
DATABASE_URL=postgresql://phone_farm:replace-password@minipc-ubuntu:55432/phone_farm

# Optional preconfigured egress contexts exposed only as route IDs/device scope.
# Secrets/endpoints remain worker-local and are never advertised to the MiniPC.
# PHONE_FARM_NETWORK_ROUTES=[{"id":"direct"},{"id":"testing-eu","deviceUdids":["127.0.0.1:5555"]}]

APPIUM_RUNTIME_HOST=127.0.0.1
APPIUM_RUNTIME_PORT=4726
DEVICES_CONFIG_PATH=devices.json
SCHEDULER_DATA_DIR=.scheduler-data

# Appium/UiAutomator2 needs a complete Android SDK, not only an adb binary.
# The installer defaults to this user-local root when these are omitted.
# ANDROID_HOME=/home/your-user/.local/share/android-sdk
# ANDROID_SDK_ROOT=/home/your-user/.local/share/android-sdk
# JAVA_HOME may be omitted when java is available on PATH.

# Optional Android H.264 video transport. The jar/version must match.
# PHONE_FARM_SCRCPY_SERVER_JAR=/absolute/path/to/scrcpy-server.jar
# PHONE_FARM_SCRCPY_VERSION=4.0
# PHONE_FARM_SCRCPY_MAX_SIZE=1920
