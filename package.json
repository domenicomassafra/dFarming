{
  "name": "@domenicomassafra/dfarming-core",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Cross-platform mobile device farm control plane for real and virtual iOS and Android devices",
  "files": [
    "src",
    "static",
    "Patches",
    "drizzle",
    "docker-compose.yml",
    "README.md",
    "PLUGIN_DEVELOPMENT.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tiktok": "./src/tiktok-plugin.ts",
    "./instagram": "./src/instagram-plugin.ts",
    "./example-plugin": "./src/example-plugin.ts",
    "./server": "./src/api/server.ts",
    "./worker": "./src/scheduler/worker.ts"
  },
  "scripts": {
    "doctor": "node --import tsx src/doctor.ts",
    "doctor:control-plane": "PHONE_FARM_ROLE=control-plane node --env-file-if-exists=.env.minipc --env-file-if-exists=.env --import tsx src/doctor.ts",
    "doctor:device-worker": "PHONE_FARM_ROLE=device-worker node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/doctor.ts",
    "agent:client": "node --import tsx src/agent/cli.ts",
    "agent:mcp": "node --import tsx src/agent/mcp.ts",
    "device-worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/device-worker-server.ts",
    "service": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/service.ts",
    "acceptance:live": "node --import tsx src/acceptance-live.ts",
    "benchmark:video": "node --import tsx src/video-benchmark.ts",
    "appium": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js --address 127.0.0.1 --base-path / --port 4725 --log-level info",
    "appium:install-driver": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js driver install xcuitest@12.13.1",
    "appium:runtime": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js --address 127.0.0.1 --base-path / --port 4726 --log-level info",
    "appium:runtime:install-ios": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js driver install xcuitest@12.13.1",
    "appium:runtime:install-android": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js driver install uiautomator2@8.7.0",
    "appium:runtime:drivers": "APPIUM_HOME=.appium-runtime node node_modules/appium-runtime/index.js driver list --installed",
    "appium:runtime:harden": "node --import tsx src/appium-runtime-hardening.ts prepare && npm install --prefix .appium-runtime --ignore-scripts && node --import tsx src/appium-runtime-hardening.ts repair && npm run audit:appium-runtime",
    "appium:runtime:sync": "node --import tsx src/appium-runtime-hardening.ts sync && npm install --prefix .appium-runtime --ignore-scripts && node --import tsx src/appium-runtime-hardening.ts repair && npm run audit:appium-runtime",
    "wda:patch": "node --import tsx src/devices/wda/patch.ts",
    "wda:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/devices/wda/prepare.ts",
    "wda:service": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/devices/wda-service.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "npm run db:toolchain:install --silent && node toolchains/db-schema/node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts",
    "db:setup": "node --env-file-if-exists=.env --import tsx src/database/setup.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/scheduler/worker.ts",
    "web": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/api/server.ts",
    "instagram:leads:import": "node --env-file-if-exists=.env --import tsx src/instagram/leads-import.ts",
    "hinge:shadow": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/hinge/shadow.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "preweb": "npm run build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "audit:appium-runtime": "npm audit --prefix .appium-runtime --audit-level=low",
    "db:toolchain:install": "npm ci --prefix toolchains/db-schema --ignore-scripts",
    "audit:db-schema": "npm audit --prefix toolchains/db-schema --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "appium-ios-device": "^3.1.21",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.1",
    "htmx.org": "^2.0.11",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "appium-runtime": "npm:appium@^3.7.0",
    "node-native-ocr": "^0.4.18",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "appium@3.7.0": false,
    "node-native-ocr@0.4.18": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js": false,
    "edgedriver": false,
    "geckodriver": false,
    "fsevents": false
  },
  "overrides": {
    "morgan": "1.12.1"
  }
}
