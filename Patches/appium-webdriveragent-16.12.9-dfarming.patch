+static BOOL FBIsAbsoluteSingleTouchAction(NSArray *actions)
+{
+  if (1 != actions.count) return NO;
+  NSDictionary *action = actions.firstObject;
+  if (![[action objectForKey:@"type"] isEqualToString:@"pointer"]
+      || ![[[action objectForKey:@"parameters"] objectForKey:@"pointerType"] isEqualToString:@"touch"]) return NO;
+  for (NSDictionary *item in [action objectForKey:@"actions"]) {
+    NSString *type = [item objectForKey:@"type"];
+    if ([type isEqualToString:@"pointerMove"]) {
+      id origin = [item objectForKey:@"origin"];
+      if (nil != origin && ![origin isEqualToString:@"viewport"]) return NO;
+      if (nil == [item objectForKey:@"x"] || nil == [item objectForKey:@"y"]) return NO;
+    } else if (![@[@"pointerDown", @"pointerUp", @"pause"] containsObject:type]) return NO;
+  }
+  return YES;
+}
+
+static BOOL FBPerformAbsoluteSingleTouchAction(NSArray *actions, NSError **error)
+{
+  NSArray *items = [actions.firstObject objectForKey:@"actions"];
+  CGPoint point = CGPointZero;
+  BOOL hasPoint = NO;
+  NSTimeInterval offset = 0;
+  XCPointerEventPath *eventPath = nil;
+  for (NSDictionary *item in items) {
+    NSString *type = [item objectForKey:@"type"];
+    NSTimeInterval duration = [[item objectForKey:@"duration"] doubleValue] / 1000.0;
+    if ([type isEqualToString:@"pause"]) { offset += duration; continue; }
+    if ([type isEqualToString:@"pointerMove"]) {
+      offset += duration;
+      point = CGPointMake([[item objectForKey:@"x"] doubleValue], [[item objectForKey:@"y"] doubleValue]);
+      hasPoint = YES;
+      if (nil != eventPath) [eventPath moveToPoint:point atOffset:offset];
+      continue;
+    }
+    if ([type isEqualToString:@"pointerDown"] && hasPoint && nil == eventPath) {
+      eventPath = [[XCPointerEventPath alloc] initForTouchAtPoint:point offset:offset];
+      continue;
+    }
+    if ([type isEqualToString:@"pointerUp"] && nil != eventPath) [eventPath liftUpAtOffset:offset];
+  }
+  if (nil == eventPath) return NO;
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc]
+                                      initWithName:@"Absolute Touch Action"
+                                      interfaceOrientation:UIInterfaceOrientationPortrait];
+  [record addPointerEventPath:eventPath];
+  return [FBXCTestDaemonsProxy synthesizeEventWithRecord:record error:error];
+}
