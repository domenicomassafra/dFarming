DFARMING_ROLE=device-worker
DFARMING_WORKER_ID=macstudio
DFARMING_ENABLE_PHYSICAL_IOS=true
DEVICE_WORKER_HOST=0.0.0.0
DEVICE_WORKER_PORT=3010
DFARMING_DEVICE_WORKER_TOKEN=replace-with-the-same-token-as-minipc

# MiniPC URLs. Prefer Tailscale/private LAN addressing, never public Internet.
DFARMING_CONTROL_PLANE_URL=https://minipc-ubuntu.garibaldi-atlas.ts.net:18443
DFARMING_INTERNAL_TOKEN=replace-with-the-same-internal-token-as-minipc
DATABASE_URL=postgresql://dfarming:replace-password@minipc-ubuntu:55432/dfarming

# Optional worker-local egress attestations. Only route IDs and optional device
# scope are advertised to the MiniPC; proxy/VPN credentials and endpoints stay
# outside dFarming on this worker. Comma-separated IDs are also accepted.
# DFARMING_NETWORK_ROUTES=[{"id":"direct"},{"id":"italy.private","deviceUdids":["device-udid"]}]

APPIUM_HOST=127.0.0.1
APPIUM_PORT=4725
# Modern cross-platform sidecar: iOS Simulator + Android physical/emulator.
APPIUM_RUNTIME_HOST=127.0.0.1
APPIUM_RUNTIME_PORT=4726
DEVICES_CONFIG_PATH=devices.json
SCHEDULER_DATA_DIR=.scheduler-data
DFARMING_RUNTIME_DISK_BUDGET_GB=20
DFARMING_RUNTIME_STALE_DAYS=14
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100

TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
INSTAGRAM_BUNDLE_ID=com.burbn.instagram
IOS_PLATFORM_VERSION=16.7
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID="Apple Development"
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner

# Optional Android low-latency video benchmark. Supply a verified, matching
# official scrcpy-server jar yourself; the farm never downloads or vendors it.
# DFARMING_SCRCPY_SERVER_JAR=/absolute/path/to/scrcpy-server-v4.0
# DFARMING_SCRCPY_VERSION=4.0
# DFARMING_SCRCPY_MAX_SIZE=1920
